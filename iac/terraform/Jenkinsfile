pipeline {
    agent { label 'terraform' }

    options {
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        ansiColor('xterm')
    }

    environment {
        TF_DIR = 'iac/terraform'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'terraform version'
                sh 'aws --version'
            }
        }
        stage('Init') {
            steps {
                dir(env.TF_DIR) {
                    sh 'terraform init -no-color'
                }
            }
        }
        stage('Plan') {
            steps {
                withCredentials([
                    string(credentialsId: 'aws-access-key-id',     variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_ACCESS_KEY')
                ]) {
                    dir(env.TF_DIR) {
                        sh '''
                            terraform plan -no-color \
                              -var owner_name=${BUILD_USER_ID:-ci} \
                              -out=tfplan
                        '''
                    }
                }
            }
        }
        stage('Approval') {
            steps {
                script {
                    def go = input(
                        message: "Apply the plan?",
                        ok: "Yes, apply",
                        parameters: [choice(name: 'CONFIRM', choices: ['no','yes'], description: 'Type yes')]
                    )
                    if (go != 'yes') { error 'Apply rejected by approver.' }
                }
            }
        }
        stage('Apply') {
            steps {
                withCredentials([
                    string(credentialsId: 'aws-access-key-id',     variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_ACCESS_KEY')
                ]) {
                    dir(env.TF_DIR) {
                        sh 'terraform apply -auto-approve -no-color tfplan'
                        sh 'terraform output'
                    }
                }
            }
        }
    }

    post {
        success { echo "Pipeline succeeded — applied on ${env.BUILD_TIMESTAMP}" }
        failure { echo "Pipeline failed — review the failing stage" }
        always  { echo "Duration: ${currentBuild.durationString}" }
    }
}
